{
  "name": "picview",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:layout": "esbuild tools/check-layout.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/check-layout.cjs --log-level=warning && node node_modules/.tmp/check-layout.cjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "release": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tauri-apps/api": "^2.2.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicView",
  "version": "2.0.0",
  "identifier": "com.stiz.picview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PicView",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "focus": true,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://picv.localhost https://picv.localhost picv:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://picv.localhost https://picv.localhost picv:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "stiz",
    "category": "Graphics and Design",
    "shortDescription": "起動が速い画像ビューア",
    "longDescription": "画像をダブルクリックした瞬間に開く、UIの消える画像ビューアです。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "jfif",
          "gif",
          "webp",
          "bmp",
          "avif",
          "ico",
          "tif",
          "tiff",
          "tga",
          "dds",
          "qoi",
          "ppm",
          "pgm",
          "pbm",
          "pnm",
          "hdr"
        ],
        "name": "PicView Image",
        "description": "画像ファイル",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      }
    }
  }
}
